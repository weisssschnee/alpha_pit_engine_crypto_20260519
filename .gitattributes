# Closure manifests bind exact bytes. Keep their text and executable inputs
# stable across Windows and POSIX checkouts; keep columnar evidence binary.
alphafactory_crypto/frontier_v2/** text eol=lf
config/crypto_frontier_research_v2.json text eol=lf
config/crypto_frontier_evidence_qualification_v1.json text eol=lf
scripts/crypto_frontier_research_v2.py text eol=lf
scripts/crypto_frontier_evidence_qualification.py text eol=lf
scripts/run_crypto_frontier_research_v2.ps1 text eol=lf
scripts/run_crypto_frontier_evidence_qualification.ps1 text eol=lf
# Runtime artifacts are content-hashed in their generated byte form. Do not
# normalize their line endings; Parquet is naturally covered by the same rule.
runtime/crypto_frontier_research_v2_20260713/** -text whitespace=cr-at-eol
runtime/crypto_frontier_provenance_closure_20260714/** -text whitespace=cr-at-eol
